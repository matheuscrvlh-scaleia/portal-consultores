# Supabase project settings (Project Settings -> API)
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Server-only secret (service role) - bypasses RLS. Never expose to the client bundle.
# Required by src/integrations/supabase/client.server.ts. Set this in Vercel's
# Environment Variables for the deployed app; do not commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=""

# Same values, exposed to the client bundle via Vite's VITE_ prefix.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Production URL, used for the sitemap and JSON-LD (no trailing slash).
VITE_SITE_URL="http://localhost:8080"
